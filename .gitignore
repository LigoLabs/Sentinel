# ----------------------------------------------------------------------------
# Sentinel — .gitignore
# ----------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/
.playwright-mcp

# Build outputs
dist/
build/
.svelte-kit/
*.tsbuildinfo
.vite/
.turbo/
.cache/

# Runtime data (database + backups)
data/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
pm2.log
.pm2/

# Test outputs / coverage
coverage/
.nyc_output/
*.lcov

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite3

# Sensitive material (defensive — should never live in the repo)
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_ed25519

# IDE / editors
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/
*.swp
*.swo
*.swn
*~

# OS files
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temp / scratch
tmp/
temp/
*.bak
*.tmp

# AI agent context (kept out of the repo on purpose)
CLAUDE.md
