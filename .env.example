# Sentinel Configuration
NODE_ENV=development
PORT=8082

# Security - left empty: auto-generated and persisted on first boot.
# To rotate manually, replace with a new 64-char hex string and restart.
JWT_SECRET=
ENCRYPTION_KEY=

# Admin password (plaintext, used for login)
ADMIN_PASSWORD=sentinel

# Storage paths
DATA_DIR=./data
BACKUP_DIR=./data/backups

# Logging
LOG_LEVEL=info

# External monitoring (optional)
# Create a free check at https://healthchecks.io and paste the ping URL
HEALTHCHECKS_PING_URL=

# Email notifications (optional)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Sentinel
ALERT_EMAIL=
